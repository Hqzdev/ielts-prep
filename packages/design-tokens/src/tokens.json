{
  "version": 1,
  "properties": {
    "color-aubergine": "#3c315b",
    "color-ghost-lavender": "#e2dffe",
    "color-periwinkle": "#ab9ff2",
    "color-cornflower-pop": "#4a87f2",
    "color-buttercream": "#ffffc4",
    "color-blush-mist": "#ffdadc",
    "color-mint-signal": "#2ec08b",
    "color-paper-white": "#fdfcfe",
    "color-white": "#ffffff",
    "color-obsidian": "#1c1c1c",
    "color-fog": "#86848d",
    "color-ash": "#e9e8ea",
    "color-bone": "#f4f2f4",
    "color-muted": "#6e667d",
    "color-lavender-ink": "#65548e",
    "color-blue-ink": "#285bb0",
    "color-blush-ink": "#864751",
    "color-butter-ink": "#74651f",
    "color-mint-ink": "#176b52",
    "color-berry": "#a63c55",
    "color-berry-hover": "#8e3047",
