    "background": "var(--color-paper-white)",
    "surface": "var(--color-white)",
    "ink": "var(--color-obsidian)",
    "heading": "var(--color-aubergine)",
    "secondary": "var(--color-muted)",
    "muted": "var(--color-muted)",
    "border": "var(--color-ash)",
    "border-control": "var(--color-border-strong)",
    "link": "var(--color-aubergine)",
    "action": "var(--color-ghost-lavender)",
    "action-hover": "var(--color-lavender-hover)",
    "action-ink": "var(--color-aubergine)",
    "focus": "var(--color-lavender-ink)",
    "progress": "var(--color-lavender-ink)",
    "blue": "var(--color-cornflower-pop)",
    "blue-wash": "var(--color-blue-wash)",
    "yellow": "var(--color-buttercream)",
    "mint": "var(--color-mint-signal)",
    "lavender": "var(--color-ghost-lavender)",
    "ember": "var(--color-blush-mist)",
    "violet": "var(--color-periwinkle)",
    "mist": "var(--color-bone)",
    "coral-wash": "var(--color-ghost-lavender)",
    "success": "var(--color-mint-ink)",
    "success-surface": "var(--color-mint-wash)",
    "danger": "var(--color-berry)",
    "danger-hover": "var(--color-berry-hover)",
    "danger-surface": "var(--color-blush-mist)",
    "on-dark": "var(--color-paper-white)",
    "muted-on-dark": "var(--color-ghost-lavender)",
    "reading": "var(--color-cornflower-pop)",
    "reading-surface": "var(--color-blue-wash)",
    "reading-ink": "var(--color-blue-ink)",
    "listening": "var(--color-ghost-lavender)",
    "listening-ink": "var(--color-lavender-ink)",
    "writing": "var(--color-blush-mist)",
    "writing-ink": "var(--color-blush-ink)",
    "speaking": "var(--color-buttercream)",
    "speaking-ink": "var(--color-butter-ink)",
    "vocabulary": "var(--color-periwinkle)",
    "vocabulary-ink": "var(--color-aubergine)",
    "weight-display": "400",
    "weight-body": "400",
    "tracking": "0",
    "radius": "24px",
    "radius-control": "16px",
    "radius-pill": "100px",
    "shadow": "none",
    "shadow-glow": "0 0 4px var(--color-ghost-lavender)"
  },
  "typography": {
    "display": {
      "family": "OrbitDisplay",
      "weight": 400,
      "webVariable": "--font-display"
    },
    "body": {
      "family": "Nunito Sans",
      "weight": 400,
      "webVariable": "--font-body"
    }
  },
  "assets": [
