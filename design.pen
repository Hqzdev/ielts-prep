                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "PASSAGE 1 · QUESTIONS 1–13",
                              "lineHeight": 1.4,
                              "fontFamily": "Inter",
                              "fontSize": 11,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "PU1MY",
                              "name": "Heading · The city beneath the trees",
                              "fill": "$mac-text",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "The city beneath the trees",
                              "lineHeight": 1.18,
                              "fontFamily": "$veylo-heading",
                              "fontSize": 26,
                              "fontWeight": "800"
                            },
                            {
                              "type": "text",
                              "id": "JyiST",
                              "name": "Reading paragraph 1",
                              "fill": "$mac-text",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Urban trees do more than provide shade. Their leaves cool the surrounding air, while their roots help absorb rainwater. In busy cities, these everyday effects can change the way a neighbourhood feels.",
                              "lineHeight": 1.7,
                              "fontFamily": "Inter",
                              "fontSize": 16
                            },
                            {
                              "type": "text",
                              "id": "V5mGHX",
                              "name": "Highlighted evidence",
                              "fill": "$mac-reading-ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Their leaves cool the surrounding air.",
                              "lineHeight": 1.4,
                              "fontFamily": "Inter",
                              "fontSize": 16,
                              "fontWeight": "500"
                            },
                            {
                              "type": "text",
                              "id": "AlEFo",
                              "name": "Reading paragraph 2",
                              "fill": "$mac-text",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Researchers have found that streets with a mature tree canopy can be noticeably cooler than nearby streets without trees. The benefit varies with the season, the species and the amount of space available for roots.",
                              "lineHeight": 1.7,
                              "fontFamily": "Inter",
                              "fontSize": 16
                            },
                            {
                              "type": "text",
                              "id": "ff204",
                              "name": "Reading paragraph 3",
                              "fill": "$mac-text",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Urban planners are increasingly treating trees as part of the city’s infrastructure. Planting is only a first step: young trees need maintenance, water and enough room to grow.",
                              "lineHeight": 1.7,
                              "fontFamily": "Inter",
                              "fontSize": 16
                            }
                          ]
                        }
                      ]
                    },
