{
  "name": "veylo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @veylo/web dev",
    "build": "pnpm --filter @veylo/web build",
    "start": "pnpm --filter @veylo/web start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "TEST_INTEGRATION=1 vitest run apps/web/tests/api.integration.test.ts apps/web/tests/native-auth.integration.test.ts apps/web/tests/load.integration.test.ts apps/web/tests/native-learning.integration.test.ts",
    "test:e2e": "pnpm --filter @veylo/web test:e2e",
    "content:check": "pnpm --filter @veylo/web content:check",
    "local:setup": "pnpm --filter @veylo/web local:setup",
    "db:seed": "pnpm --filter @veylo/web db:seed",
    "db:migrate": "supabase migration up --local --workdir infra",
    "check": "pnpm format:check && pnpm architecture:check && pnpm api:check && pnpm design:check && pnpm lint && pnpm typecheck && pnpm test && pnpm content:check && pnpm build",
    "architecture:check": "node scripts/check-architecture.mjs",
    "api:generate": "node --import tsx scripts/generate-api.ts",
    "api:check": "node --import tsx scripts/generate-api.ts --check",
    "design:generate": "node scripts/generate-design.mjs",
    "design:check": "node scripts/generate-design.mjs --check",
    "python:check": "node scripts/check-python.mjs",
    "swift:check": "node scripts/check-swift.mjs",
    "swift:resolve": "node scripts/check-swift.mjs --resolve",
    "test:sql": "node scripts/test-database.mjs",
    "native:configure": "node --import tsx apps/web/scripts/configure-native.ts",
    "native:prepare-tests": "node --import tsx apps/web/scripts/prepare-native-tests.ts",
    "hooks:install": "node scripts/install-hooks.mjs",
    "postinstall": "node scripts/generate-design.mjs && node scripts/install-hooks.mjs",
    "admin:invite": "pnpm --filter @veylo/web admin:invite",
    "assessment:evaluate": "pnpm --filter @veylo/web assessment:evaluate"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "supabase": "^2.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
