{
  "name": "@veylo/web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --dir ../.. test",
    "test:e2e": "playwright test",
    "content:check": "node --import tsx scripts/validate-content.ts",
    "db:seed": "node --import tsx scripts/seed.ts",
    "local:setup": "node scripts/local-setup.mjs",
    "admin:invite": "node --import tsx scripts/invite.ts",
    "assessment:evaluate": "node --import tsx scripts/evaluate.ts",
    "postinstall": "node scripts/copy-vad.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@ricky0123/vad-web": "^0.0.30",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.0.0",
    "@veylo/api-client": "workspace:*",
    "@veylo/backend": "workspace:*",
    "@veylo/contracts": "workspace:*",
    "@veylo/design-tokens": "workspace:*",
    "@veylo/ui-web": "workspace:*",
    "@xyflow/react": "^12.0.0",
    "idb": "^8.0.0",
    "lucide-react": "^0.577.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.0.0",
    "server-only": "^0.0.1",
    "workflow": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "tailwindcss": "^4.0.0"
  }
}
