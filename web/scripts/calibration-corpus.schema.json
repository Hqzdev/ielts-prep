{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "minItems": 1,
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "split": {
        "type": "string",
        "enum": ["tuning", "holdout"]
      },
      "source": {
        "type": "string",
        "minLength": 1
      },
      "expertBand": {
        "type": "number",
        "minimum": 1,
        "maximum": 9,
        "multipleOf": 0.5
      },
      "task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "default": 1,
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "skill": {
            "type": "string",
            "enum": ["writing", "speaking", "reading"]
          },
          "part": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "topic": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "durationSeconds": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "minimumWords": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "prompt": {
            "type": "string"
          },
          "instructions": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "source": {
            "default": "authored_practice",
            "type": "string"
          },
          "passageId": {
            "type": "string"
          },
          "paragraphs": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": ["label", "text"],
              "additionalProperties": false
            }
          },
          "readingQuestions": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "number": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "statement": {
                  "type": "string",
                  "minLength": 1
                },
                "mode": {
                  "type": "string",
                  "enum": ["single", "multiple", "text"]
                },
                "options": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      }
                    },
                    "required": ["value", "label"],
                    "additionalProperties": false
                  }
                },
                "selectCount": {
                  "default": 1,
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "maxWords": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "allowNumber": {
                  "default": false,
                  "type": "boolean"
                },
                "group": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "number",
                "statement",
                "mode",
                "options",
                "selectCount",
                "allowNumber"
              ],
              "additionalProperties": false
            }
          },
          "readingLayout": {
            "default": "list",
            "type": "string",
            "enum": [
              "list",
              "summary",
              "notes",
              "table",
              "flowchart",
              "diagram"
            ]
          },
          "reuseAllowed": {
            "default": true,
            "type": "boolean"
          },
          "diagram": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "nodes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "questionNumber": {
                      "type": "number"
                    }
                  },
                  "required": ["id", "label", "x", "y"],
                  "additionalProperties": false
                }
              },
              "edges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "source": {
                      "type": "string"
                    },
                    "target": {
                      "type": "string"
                    }
                  },
                  "required": ["source", "target"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["title", "nodes", "edges"],
            "additionalProperties": false
          },
          "visual": {
            "type": "object",
            "properties": {
              "chartType": {
                "type": "string",
                "enum": [
                  "bar_chart",
                  "line_graph",
                  "pie_chart",
                  "table",
                  "process_diagram"
                ]
              },
              "title": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              },
              "periods": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "dataSeries": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "category": {
                      "type": "string"
                    },
                    "values": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "number"
                      }
                    }
                  },
                  "required": ["category", "values"],
                  "additionalProperties": false
                }
              },
              "processKind": {
                "type": "string",
                "enum": ["linear", "cyclical"]
              },
              "processSteps": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "chartType",
              "title",
              "periods",
              "dataSeries",
              "processSteps"
            ],
            "additionalProperties": false
          },
          "speakingQuestions": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cuePoints": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "preparationSeconds": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "relatedTaskId": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "version",
          "title",
          "skill",
          "part",
          "topic",
          "format",
          "durationSeconds",
          "minimumWords",
          "prompt",
          "instructions",
          "createdAt",
          "source",
          "paragraphs",
          "readingQuestions",
          "readingLayout",
          "reuseAllowed",
          "speakingQuestions",
          "cuePoints",
          "preparationSeconds"
        ],
        "additionalProperties": false
      },
      "answer": {
        "default": "",
        "type": "string"
      },
      "audio": {
        "default": [],
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "questionIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["path", "questionIndex"],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "id",
      "split",
      "source",
      "expertBand",
      "task",
      "answer",
      "audio"
    ],
    "additionalProperties": false
  }
}
